{
    "name": "@dcb-es/examples-course-manager-web-api-sliced",
    "author": "Paul Grimshaw",
    "license": "BSD-3-Clause",
    "version": "0.0.1",
    "type": "module",
    "private": true,
    "scripts": {
        "start": "node dist/index.js",
        "test": "vitest run",
        "test:scenario": "vitest run --reporter=verbose src/scenario.tests.ts",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "build": "tsc -p tsconfig.build.json",
        "watch": "tsc -w -p tsconfig.build.json",
        "lint": "eslint \"**/*.ts\" .",
        "lint-fix": "eslint \"**/*.ts\" . --fix"
    },
    "dependencies": {
        "@asteasolutions/zod-to-openapi": "^7.0.0",
        "@dcb-es/event-store": "workspace:*",
        "@dcb-es/event-store-express": "workspace:*",
        "@dcb-es/event-store-postgres": "workspace:*",
        "@event-driven-io/dumbo": ">=0.13.0-beta.52",
        "@event-driven-io/pongo": ">=0.17.0-beta.52",
        "pg": "^8.20.0",
        "zod": "^3.0.0"
    },
    "devDependencies": {
        "@testcontainers/postgresql": "^10.9.0",
        "@types/pg": "^8.20.0",
        "@types/supertest": "^6.0.2",
        "supertest": "^7.1.0",
        "testcontainers": "^10.9.0"
    }
}
